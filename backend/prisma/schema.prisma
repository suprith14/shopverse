// ShopVerse database schema.
// All money values are stored as integers in the smallest currency unit (cents),
// never as floats, to avoid rounding errors (0.1 + 0.2 !== 0.3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING // created, waiting for payment
  PAID // Stripe webhook confirmed payment
  SHIPPED
  DELIVERED
  CANCELLED // payment never completed / reservation expired
  REFUNDED
}

enum ReservationStatus {
  ACTIVE // stock is held for an unpaid order
  CONSUMED // order was paid, stock permanently deducted
  RELEASED // order expired/cancelled, stock returned
}

enum DiscountType {
  PERCENT // value = percentage, e.g. 10 => 10% off
  FIXED // value = cents off, e.g. 500 => $5 off
}

// ---------------------------------------------------------------- Users & auth

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  // Profile details (all optional)
  phone       String? // international format, e.g. "+919876543210"
  dateOfBirth DateTime? @db.Date // a DATE, not a timestamp: birthdays have no time zone
  avatarUrl   String? // the image itself lives on Cloudinary; only its URL is stored here

  // Last time this user made a logged-in request. Written at most once every 5 minutes per
  // user (see lib/activity.ts), so it costs ~1 write per active user per 5 minutes.
  // Powers "active now / active today" on the admin dashboard.
  lastSeenAt DateTime?

  // Set by an admin: the customer can't log in, check out or reset their password until unblocked.
  blockedAt     DateTime?
  blockedReason String? // shown to admins only, never to the customer
  // Set when an admin deleted a customer who has orders: the account is anonymised (no name, email,
  // phone or addresses left) but the orders stay, because invoices must be kept for accounting.
  deletedAt     DateTime?

  // ONE slot for the default address, so "two default addresses" is impossible by design.
  // Deleting that address clears the slot (SetNull). The backend checks the address belongs to this user.
  defaultAddressId String?   @unique
  defaultAddress   Address?  @relation("DefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  addresses        Address[] @relation("UserAddresses")

  refreshTokens      RefreshToken[]
  passwordResetCodes PasswordResetCode[]
  cartItems          CartItem[]
  wishlist           WishlistItem[]
  orders             Order[]
  reviews            Review[]

  @@index([lastSeenAt]) // "who was active in the last 15 minutes?" without reading every user
  @@index([createdAt]) // "who signed up this month?"
}

// "Forgot password" one-time codes (6 digits, emailed).
// Only an HMAC of the code is stored (keyed with a server secret): with just 1,000,000 possible
// codes, a plain hash from a leaked database could be cracked in seconds; without the secret it can't.
// One active code per user (a new request deletes the old one), 15-minute expiry, max 5 tries.
model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0) // wrong guesses so far; burned at 5
  expiresAt DateTime
  usedAt    DateTime? // set when used (or burned), so it can never work twice
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A delivery address in a customer's address book (a user can have several).
// Orders don't point here: checkout COPIES the address into Order.shippingAddress (a snapshot),
// so editing or deleting an address later never changes where a past order was shipped.
model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)
  defaultFor User?    @relation("DefaultAddress")
  label      String? // optional nickname: "Home", "Office"
  fullName   String // who receives the parcel (may differ from the account name)
  phone      String // the delivery partner calls this number
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String // ISO code, e.g. "IN", "US"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// We store only a hash of each refresh token. If the DB leaks, the tokens can't be used.
// Rotation: every refresh revokes the old token and issues a new one.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------- Catalog

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  brand       String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  // Lowest variant price, kept in sync so we can filter/sort products by price cheaply.
  basePrice   Int
  images      String[]
  // Category-specific details: { author, pages } for books, { specs } for electronics...
  attributes  Json     @default("{}")
  // Denormalized rating stats, updated when a review is written (avoids AVG() on every list query).
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Full-text search: the product's words reduced to their roots, weighted
  // (name = A, brand = B, description = C). PostgreSQL computes it automatically from those
  // columns (a GENERATED column, see migration add_product_search). Never written by the app.
  // The @default below is the generation expression exactly as PostgreSQL stores it. Prisma
  // can't create generated columns, but declaring it stops Prisma from trying to "remove" it.
  searchVector Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('english'::regconfig, COALESCE(name, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(brand, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'C'::\"char\"))"))

  variants     ProductVariant[]
  reviews      Review[]
  wishlistedBy WishlistItem[]

  @@index([categoryId])
  @@index([basePrice])
  @@index([searchVector], type: Gin) // makes "which products contain these words?" fast
}

// A purchasable version of a product: "Size 9 / Black", "256GB", "Hardcover".
// Price and stock live here, not on Product.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  name      String
  options   Json    @default("{}") // e.g. { "size": "9", "color": "Black" }
  price     Int
  stock     Int     @default(0)

  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations StockReservation[]

  @@index([productId])
}

// ---------------------------------------------------------------- Cart & wishlist

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------------------------------------------------------- Orders & payments

model Order {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  status                OrderStatus @default(PENDING)
  subtotal              Int
  discount              Int         @default(0)
  total                 Int
  couponId              String?
  coupon                Coupon?     @relation(fields: [couponId], references: [id])
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  shippingAddress       Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Invoice: numbered only once paid, from InvoiceCounter (sequential, no gaps). Shown as INV-2026-00042.
  invoiceNumber   Int?      @unique
  invoiceIssuedAt DateTime?
  // Secret, random, used ONLY in the invoice's "verify" QR code / link. Not the invoice number
  // (guessable) and not the order id (used elsewhere). The public verify page it opens shows
  // no personal data: number, date, total, paid/refunded.
  invoiceToken    String?   @unique
  // Card details copied from Stripe when the payment is confirmed, so invoices don't call Stripe.
  // Only the brand and last 4 digits: the full card number never reaches us (Stripe keeps it).
  cardBrand       String? // "visa", "mastercard"...
  cardLast4       String?
  receiptUrl      String? // Stripe's hosted receipt page

  items        OrderItem[]
  reservations StockReservation[]

  @@index([userId])
  @@index([status, createdAt])
}

// One row per counter (id "invoice"). Taking the next invoice number is an atomic
// "UPDATE ... SET value = value + 1 RETURNING value" inside the payment transaction:
// the row lock makes simultaneous payments take turns (no duplicates), and a failed
// transaction rolls the +1 back (no gaps), which a PostgreSQL sequence can't promise.
model InvoiceCounter {
  id    String @id
  value Int    @default(0)
}

// Snapshot of what was bought. Product name/price are copied so the order history
// stays correct even if the product is later renamed, repriced or deleted.
model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  variantName String
  unitPrice   Int
  quantity    Int
}

// Holds stock while a customer is paying, so two people can't buy the last item.
model StockReservation {
  id        String            @id @default(cuid())
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id])
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  @@index([status, expiresAt])
}

// Stripe can deliver the same webhook more than once. We record processed event IDs
// so handling is idempotent (an order is never marked paid / stock deducted twice).
model ProcessedWebhookEvent {
  id          String   @id // Stripe event id, e.g. evt_123
  type        String
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------- Reviews & coupons

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  title     String
  body      String
  createdAt DateTime @default(now())

  @@unique([userId, productId]) // one review per user per product
  @@index([productId])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Int
  minOrderAmount Int          @default(0)
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  orders         Order[]
}
