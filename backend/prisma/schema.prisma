// ShopVerse database schema.
// All money values are stored as integers in the smallest currency unit (cents),
// never as floats, to avoid rounding errors (0.1 + 0.2 !== 0.3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING // created, waiting for payment
  PAID // Stripe webhook confirmed payment
  SHIPPED
  DELIVERED
  CANCELLED // payment never completed / reservation expired
  REFUNDED
}

enum ReservationStatus {
  ACTIVE // stock is held for an unpaid order
  CONSUMED // order was paid, stock permanently deducted
  RELEASED // order expired/cancelled, stock returned
}

enum DiscountType {
  PERCENT // value = percentage, e.g. 10 => 10% off
  FIXED // value = cents off, e.g. 500 => $5 off
}

// ---------------------------------------------------------------- Users & auth

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  refreshTokens RefreshToken[]
  cartItems     CartItem[]
  wishlist      WishlistItem[]
  orders        Order[]
  reviews       Review[]
}

// We store only a hash of each refresh token. If the DB leaks, the tokens can't be used.
// Rotation: every refresh revokes the old token and issues a new one.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------- Catalog

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  brand       String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  // Lowest variant price, kept in sync so we can filter/sort products by price cheaply.
  basePrice   Int
  images      String[]
  // Category-specific details: { author, pages } for books, { specs } for electronics...
  attributes  Json     @default("{}")
  // Denormalized rating stats, updated when a review is written (avoids AVG() on every list query).
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants     ProductVariant[]
  reviews      Review[]
  wishlistedBy WishlistItem[]

  @@index([categoryId])
  @@index([basePrice])
}

// A purchasable version of a product: "Size 9 / Black", "256GB", "Hardcover".
// Price and stock live here, not on Product.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  name      String
  options   Json    @default("{}") // e.g. { "size": "9", "color": "Black" }
  price     Int
  stock     Int     @default(0)

  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations StockReservation[]

  @@index([productId])
}

// ---------------------------------------------------------------- Cart & wishlist

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------------------------------------------------------- Orders & payments

model Order {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  status                OrderStatus @default(PENDING)
  subtotal              Int
  discount              Int         @default(0)
  total                 Int
  couponId              String?
  coupon                Coupon?     @relation(fields: [couponId], references: [id])
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  shippingAddress       Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items        OrderItem[]
  reservations StockReservation[]

  @@index([userId])
  @@index([status, createdAt])
}

// Snapshot of what was bought. Product name/price are copied so the order history
// stays correct even if the product is later renamed, repriced or deleted.
model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  variantName String
  unitPrice   Int
  quantity    Int
}

// Holds stock while a customer is paying, so two people can't buy the last item.
model StockReservation {
  id        String            @id @default(cuid())
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id])
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  @@index([status, expiresAt])
}

// Stripe can deliver the same webhook more than once. We record processed event IDs
// so handling is idempotent (an order is never marked paid / stock deducted twice).
model ProcessedWebhookEvent {
  id          String   @id // Stripe event id, e.g. evt_123
  type        String
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------- Reviews & coupons

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  title     String
  body      String
  createdAt DateTime @default(now())

  @@unique([userId, productId]) // one review per user per product
  @@index([productId])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Int
  minOrderAmount Int          @default(0)
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  orders         Order[]
}
