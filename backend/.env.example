# Copy this file to .env and fill in the values.

# PostgreSQL connection string (local Postgres, Neon, Supabase, ...)
# connect_timeout=30: free Neon databases sleep when idle and take a few seconds to wake up.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shopverse?sslmode=require&connect_timeout=30"

# API tests only (npm run test:api): a SEPARATE, throwaway database. The tests empty its tables!
# Neon: create a branch named "test" and paste its connection string. Never the dev or production one.
TEST_DATABASE_URL=

# Optional. bcrypt work factor for password hashes (default 12). Don't lower it in production.
# BCRYPT_ROUNDS=12

PORT=4000

# Number of proxies in front of the API, so per-IP rate limits see the real visitor IP.
# Laptop: 0. Render behind the Vercel rewrite: 2 (Vercel + Render's load balancer).
TRUST_PROXY_HOPS=0

# Where the frontend runs. Used for CORS and for Stripe redirect URLs.
CLIENT_URL="http://localhost:5173"

# Long random string used to sign access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"

# Stripe secret key, from https://dashboard.stripe.com/test/apikeys
# Use the TEST key (sk_test_...) in development: no real money moves.
STRIPE_SECRET_KEY="sk_test_..."

# Webhook signing secret. In development, run:
#   stripe listen --forward-to localhost:4000/api/webhooks/stripe
# and copy the whsec_... value it prints.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Transactional email via Resend (https://resend.com/api-keys). Optional: without it,
# emails are printed to the backend console instead of sent.
RESEND_API_KEY="re_..."
# When set, EVERY email is sent here instead of to the customer (laptop and live demo).
# A free Resend account can only send to the email you signed up with. Leave unset in a real store.
EMAIL_DEV_REDIRECT_TO="you@example.com"

# Profile photos (https://console.cloudinary.com > Settings > API Keys). Optional: without them
# photo upload is switched off.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# Shared demo accounts whose logins are public (README): their password can't be changed or reset,
# and admins can't block or delete them. Comma-separated. Default: the two seeded demo accounts.
# Set it to an empty value in a real store.
# PROTECTED_ACCOUNTS=demo@shopverse.dev,admin@shopverse.dev
