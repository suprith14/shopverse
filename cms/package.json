{
  "name": "shopverse-cms",
  "version": "0.1.0",
  "description": "ShopVerse headless CMS: stores the store's text and serves it as JSON",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "prisma generate",
    "start": "node src/server.js",
    "db:migrate": "node scripts/check-db.js && prisma migrate dev",
    "db:deploy": "node scripts/check-db.js && prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
