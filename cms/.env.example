# Copy this file to .env and fill in the values.

# The CMS's OWN PostgreSQL database (not the shop's). Neon: open your dev branch > Databases >
# New database "cms", then copy its connection string. Add &connect_timeout=30 at the end.
DATABASE_URL=

PORT=4100

# Must be EXACTLY the same as JWT_ACCESS_SECRET in backend/.env, so the CMS accepts the
# login tokens the shop API gives to admins.
JWT_ACCESS_SECRET=

# Banner image uploads (https://console.cloudinary.com > Settings > API Keys). Optional: without
# them, uploading banner images is switched off. The same values as in backend/.env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
