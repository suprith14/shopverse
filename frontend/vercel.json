{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://shopverse-api-u9c6.onrender.com/api/:path*"
    },
    {
      "source": "/cms/:path*",
      "destination": "https://shopverse-cms.onrender.com/cms/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
